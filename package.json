{
  "name": "himmel-sales-management",
  "private": true,
  "version": "2.0.0",
  "description": "Himmel Pharmaceutical Sales Management System (web app)",
  "author": "Himmel Pharmaceutical Ltd",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"node server/scripts/dev-local.js\" \"vite\"",
    "build": "vite build",
    "preview": "vite preview",
    "start": "npm --prefix server start",
    "migrate": "npm --prefix server run migrate",
    "test": "npm --prefix server test",
    "dev:cloud": "concurrently -k -n api,web -c blue,magenta \"npm --prefix server run dev\" \"vite\""
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.2.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.19",
    "concurrently": "^10.0.3",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "vite": "^7.3.7",
    "wait-on": "^9.0.10"
  }
}
