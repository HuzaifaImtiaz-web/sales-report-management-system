{
  "name": "himmel-sales-server",
  "version": "2.0.0",
  "private": true,
  "description": "API server for the Himmel Sales System web app (shared PostgreSQL database)",
  "type": "commonjs",
  "main": "src/index.js",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "migrate": "node src/db/migrate.js",
    "local-db": "node scripts/local-db.js",
    "import-sqlite": "node scripts/import-from-sqlite.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "pdfkit": "^0.19.1",
    "pg": "^8.23.1",
    "pptxgenjs": "^4.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11"
  }
}
