# Copy this file to server/.env for local development. Never commit server/.env (it is git-ignored).
# On a hosting platform (Vercel, Render, Railway, a VPS...) set these as environment variables instead.

# NODE_ENV=production turns on Secure cookies and requires DATABASE_URL and ADMIN_PASSWORD.
NODE_ENV=production

# PostgreSQL connection string from your provider.
#   Supabase on Vercel (serverless): use the Transaction pooler (port 6543).
#   Supabase on an always-on server or for `npm run migrate`: the Session pooler (port 5432) also works.
# Local development with `npm run local-db`:
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres

# TLS for the database connection: "on" (verify certificate, default for remote hosts),
# "no-verify" (encrypted, certificate not checked) or "off" (local databases only).
# DATABASE_SSL=on
# CA certificate for the database (Supabase: Database settings > SSL Configuration > Download Certificate).
# A file path, or the PEM text itself (on Vercel paste the certificate text, with \n for line breaks).
# DATABASE_SSL_CA=

# Connections per server instance (defaults: 10, or 3 on Vercel).
# DATABASE_POOL_MAX=

# First administrator, created only while the database has no users at all.
# Must meet the password policy: 10+ characters with upper and lower case letters, a number and a symbol.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# The web app's address, e.g. https://sales.example.com (comma-separate several).
# Requests from any other website are rejected. Empty: only the address the request was sent to.
# APP_ORIGIN=

# How long a sign-in lasts (hours) and how long it survives without activity (minutes).
# SESSION_TTL_HOURS=12
# SESSION_IDLE_MINUTES=30

# Plain-HTTP local testing of a production build only. Never set this on a public server.
# COOKIE_SECURE=false

# HTTP port (most hosting platforms set PORT automatically).
PORT=4000

# Number of proxies in front of the server (1 on Vercel/Render/Railway/Fly.io/behind Nginx, 0 if exposed directly).
TRUST_PROXY=1

# Flood guard: API requests allowed per internet address in 5 minutes (an office shares one address).
# API_REQUESTS_PER_5_MINUTES=3000

# Largest unzipped backup a restore accepts.
# MAX_BODY_SIZE=100mb

# LOG_LEVEL=debug prints one line per request (development only).
