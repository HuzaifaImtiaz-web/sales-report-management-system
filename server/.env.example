# Copy this file to server/.env for local development.
# On a hosting platform (Render, Railway, Fly.io, a VPS...) set these as environment variables instead.

# PostgreSQL connection string from your provider (Supabase, Neon, Railway, AWS RDS...).
# Local development with `npm run local-db`:
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres

# TLS for the database connection: "on" (verify certificate, default for remote hosts),
# "no-verify" (encrypted, certificate not checked) or "off" (local databases only).
# DATABASE_SSL=on
# Optional CA certificate: a file path or the PEM text itself (needed by some providers).
# DATABASE_SSL_CA=

# Secret used to sign login tokens. REQUIRED in production: at least 32 random characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# How long a login stays valid.
TOKEN_TTL=12h

# First administrator, created only while the database has no users at all.
# If ADMIN_PASSWORD is empty a random password is generated and printed once in the server log.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# HTTP port (most hosting platforms set PORT automatically).
PORT=4000

# Number of proxies in front of the server (1 on Render/Railway/Fly.io/behind Nginx, 0 if exposed directly).
TRUST_PROXY=1

# NODE_ENV=production makes JWT_SECRET mandatory.
# NODE_ENV=production
